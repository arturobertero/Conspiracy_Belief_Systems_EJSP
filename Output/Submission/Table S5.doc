<table>
  <caption>Table S5 (top): reliability, Study 2. Cronbach's alpha with Feldt 95% intervals.</caption>
  <tr>
    <th class="thead firsttablerow firsttablecol col1">Dataset</th>
    <th class="thead firsttablerow col2">N</th>
    <th class="thead firsttablerow col3">CM items</th>
    <th class="thead firsttablerow col4">Alpha (CM) [95% CI]</th>
    <th class="thead firsttablerow col5">CB items</th>
    <th class="thead firsttablerow col6">Alpha (CB) [95% CI]</th>
  </tr>
  <tr>
    <td class="tdata firsttablecol lasttablerow col1">USA</td>
    <td class="tdata centeralign lasttablerow col2">2020</td>
    <td class="tdata centeralign lasttablerow col3">4</td>
    <td class="tdata centeralign lasttablerow col4">0.86 [0.85, 0.87]</td>
    <td class="tdata centeralign lasttablerow col5">6</td>
    <td class="tdata centeralign lasttablerow col6">0.83 [0.82, 0.85]</td>
</tr>
</table>
<p>&nbsp;</p><table>
  <caption>Table S5 (bottom): fit of the two-factor model, Study 2. RMSEA with its 90% interval.</caption>
  <tr>
    <th class="thead firsttablerow firsttablecol col1">Dataset</th>
    <th class="thead firsttablerow col2">Chi square</th>
    <th class="thead firsttablerow col3">p</th>
    <th class="thead firsttablerow col4">CFI</th>
    <th class="thead firsttablerow col5">TLI</th>
    <th class="thead firsttablerow col6">RMSEA [90% CI]</th>
    <th class="thead firsttablerow col7">SRMR</th>
    <th class="thead firsttablerow col8">BIC</th>
  </tr>
  <tr>
    <td class="tdata firsttablecol lasttablerow col1">USA</td>
    <td class="tdata centeralign lasttablerow col2">603.21</td>
    <td class="tdata centeralign lasttablerow col3"><.001</td>
    <td class="tdata centeralign lasttablerow col4">0.94</td>
    <td class="tdata centeralign lasttablerow col5">0.92</td>
    <td class="tdata centeralign lasttablerow col6">0.09 [0.085, 0.097]</td>
